// ============================================================
// NOTE: This application uses SQLite via better-sqlite3, NOT
// PostgreSQL via Prisma. This file is kept for reference only
// and to satisfy @next-auth/prisma-adapter type checks.
//
// The authoritative schema lives in lib/database.ts.
// DO NOT run `prisma migrate` or `prisma db push` — it will
// overwrite the real schema.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../scholar.db"
}

// ─── Core roles ─────────────────────────────────────────────
enum Role {
  PRINCIPAL
  VICE_PRINCIPAL
  TEACHER
  COUNSELOR
  ADMIN
}

// ─── Users (staff) ──────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  name         String
  role         Role      @default(TEACHER)
  departmentId String?
  phone        String?
  hireDate     String?
  isActive     Int       @default(1)
  createdAt    String    @default(dbgenerated("datetime('now')"))
}

// ─── Academic structure ─────────────────────────────────────
model AcademicYear {
  id        String @id
  name      String
  startDate String
  endDate   String
  isCurrent Int    @default(0)
}

model Term {
  id             String @id
  name           String
  academicYearId String
  startDate      String
  endDate        String
  isCurrent      Int    @default(0)
}

model Department {
  id            String  @id
  name          String
  headTeacherId String?
}

model Subject {
  id           String @id
  name         String
  code         String
  departmentId String
  creditHours  Float  @default(1.0)
}

model Room {
  id       String @id
  name     String
  building String @default("Main")
  capacity Int    @default(30)
  type     String @default("CLASSROOM")
}

model Section {
  id             String @id
  name           String
  gradeLevel     Int
  academicYearId String
  termId         String
  roomId         String?
  maxCapacity    Int    @default(35)
}

// ─── Students ───────────────────────────────────────────────
model Student {
  id             String  @id
  admissionNo    String  @unique
  name           String
  email          String?
  dateOfBirth    String?
  gender         String?
  enrollmentDate String
  status         String  @default("ACTIVE")
  gradeLevel     Int
  sectionId      String?
  createdAt      String  @default(dbgenerated("datetime('now')"))
}

model Guardian {
  id           String  @id
  name         String
  relationship String
  phone        String
  email        String?
  occupation   String?
}

model StudentGuardian {
  id         String @id
  studentId  String
  guardianId String
  isPrimary  Int    @default(0)
}

// ─── Teaching assignments ────────────────────────────────────
model TeacherSubject {
  id        String @id
  teacherId String
  subjectId String
  sectionId String
  termId    String
}

model Schedule {
  id               String  @id
  teacherSubjectId String
  dayOfWeek        Int
  period           Int
  startTime        String
  endTime          String
  roomId           String?
}

// ─── Grades & Assessments ───────────────────────────────────
model Assignment {
  id        String  @id
  title     String
  type      String
  subjectId String
  sectionId String
  teacherId String
  termId    String
  dueDate   String?
  maxScore  Float   @default(100)
  weight    Float   @default(1.0)
  createdAt String  @default(dbgenerated("datetime('now')"))
}

model Grade {
  id           String  @id
  studentId    String
  assignmentId String
  score        Float?
  feedback     String?
  submittedAt  String?
  gradedAt     String?
}

model GradeScale {
  id          String @id
  letterGrade String
  minScore    Float
  maxScore    Float
  gpa         Float
}

// ─── Attendance ─────────────────────────────────────────────
model Attendance {
  id         String  @id
  studentId  String
  sectionId  String
  date       String
  status     String
  period     Int?
  notes      String?
  markedById String?
}

// ─── Communication ──────────────────────────────────────────
model Announcement {
  id        String  @id
  title     String
  content   String
  authorId  String
  scope     String  @default("SCHOOL")
  targetId  String?
  priority  String  @default("NORMAL")
  createdAt String  @default(dbgenerated("datetime('now')"))
  expiresAt String?
}

model Event {
  id          String  @id
  title       String
  description String?
  type        String
  startDate   String
  endDate     String?
  isAllDay    Int     @default(1)
  createdBy   String
}
